# === Database (Neon PostgreSQL) ===
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# === Auth ===
JWT_SECRET="generate-a-long-random-secret-at-least-32-chars"

# === Server ===
PORT=4000
NODE_ENV=production

# Frontend URL(s) for CORS — comma-separated if several
# Example production: https://myfrontstor.netlify.app
CORS_ORIGIN="http://localhost:3000,https://myfrontstor.netlify.app"

# === Seed (dev only) ===
SEED_ADMIN_EMAIL="admin@ghazala.store"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
SEED_ADMIN_NAME="Store Admin"

# === Notif nouvelle commande (au moins un canal) ===
# Telegram (recommandé) : crée @BotFather → /newbot → copie le token
# Puis ouvre le bot, envoie /start, et récupère chat_id via:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp via CallMeBot (optionnel)
# https://www.callmebot.com/blog/free-api-whatsapp-messages/
NOTIFY_WHATSAPP_PHONE="212610364897"
NOTIFY_WHATSAPP_APIKEY=""

# Webhook générique Make.com / n8n / Discord (optionnel)
NOTIFY_WEBHOOK_URL=""
