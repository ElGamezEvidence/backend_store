# === Database (Neon PostgreSQL) ===
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# === Auth ===
JWT_SECRET="generate-a-long-random-secret-at-least-32-chars"

# === Server ===
PORT=4000
NODE_ENV=production

# Frontend URL(s) for CORS — comma-separated if several
# Example production: https://your-frontend.vercel.app
CORS_ORIGIN="http://localhost:3000"

# === Seed (dev only) ===
SEED_ADMIN_EMAIL="admin@ghazala.store"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"
SEED_ADMIN_NAME="Store Admin"
